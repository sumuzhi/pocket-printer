{
  "name": "pocket-printer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "米家口袋打印机 Pro 的独立送印服务：不进入米家 App，直接通过蓝牙打印照片",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "build:native": "node-gyp configure build --directory=native",
    "postinstall": "npm run build:native"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "node-addon-api": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "node-gyp": "^11.0.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
